-- יצירת ממשק משתמש (GUI) ברובלוקס בשחור-לבן עם טווח מהירויות 16-250
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- מחיקת ממשק קודם אם קיים
if playerGui:FindFirstChild("SpeedScriptGui") then
    playerGui.SpeedScriptGui:Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "SpeedScriptGui"
screenGui.Parent = playerGui

local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 300, 0, 400)
mainFrame.Position = UDim2.new(0.5, -150, 0.5, -200)
mainFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
mainFrame.BorderSizePixel = 2
mainFrame.Parent = screenGui

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 40)
title.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
title.TextColor3 = Color3.fromRGB(0, 0, 0)
title.Text = "ניהול מהירות (16-250)"
title.TextScaled = true
title.Font = Enum.Font.SourceSansBold
title.Parent = mainFrame

local scrollingFrame = Instance.new("ScrollingFrame")
scrollingFrame.Size = UDim2.new(1, -20, 1, -60)
scrollingFrame.Position = UDim2.new(0, 10, 0, 50)
scrollingFrame.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
scrollingFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
scrollingFrame.Parent = mainFrame

local uiGrid = Instance.new("UIGridLayout")
uiGrid.CellSize = UDim2.new(0, 50, 0, 30)
uiGrid.CellPadding = UDim2.new(0, 5, 0, 5)
uiGrid.Parent = scrollingFrame

for i = 16, 250 do
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 50, 0, 30)
    btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextColor3 = Color3.fromRGB(0, 0, 0)
    btn.Text = tostring(i)
    btn.Font = Enum.Font.SourceSansBold
    btn.TextScaled = true
    btn.Parent = scrollingFrame
    
    -- אופציה: מה קורה כשלוחצים על מהירות
    btn.MouseButton1Click:Connect(function()
        if player.Character and player.Character:FindFirstChild("Humanoid") then
            player.Character.Humanoid.WalkSpeed = i
            print("המהירות שונתה ל: " .. i)
        end
    end)
end
